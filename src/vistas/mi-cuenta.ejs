<%- include('parciales/cabecera') %>
    <section class="contenedor seccion">
      <h1>Mi cuenta</h1>
      <p><%= usuario.nombre %> <%= usuario.apellido %>, <%= usuario.correo %></p>
<% if (aviso) { %>
      <p class="mensaje-exito" role="status"><%= aviso %>.</p>
<% } %>

      <h2>Mis citas</h2>
<% if (citas.length === 0) { %>
      <p class="vacio">No tienes pruebas de manejo programadas. Puedes agendar una desde la ficha de cualquier auto.</p>
<% } else { %>
      <div class="envoltura-tabla">
        <table class="tabla">
          <thead>
            <tr><th scope="col">Código</th><th scope="col">Auto</th><th scope="col">Día</th><th scope="col">Hora</th></tr>
          </thead>
          <tbody>
<% citas.forEach((c) => { %>
            <tr>
              <td><a class="enlace" href="/citas/<%= c.codigo %>"><%= c.codigo %></a></td>
              <td><%= c.marca %> <%= c.modelo %> <%= c.anio %></td>
              <td><%= formatearDia(c.fecha) %></td>
              <td><%= formatearBloque(c.hora) %></td>
            </tr>
<% }) %>
          </tbody>
        </table>
      </div>
<% } %>

      <h2>Mis ofertas</h2>
<% if (ofertas.length === 0) { %>
      <p class="vacio">Todavía no has hecho ofertas. Puedes ofertar por un auto usado desde su ficha.</p>
<% } else { %>
      <div class="envoltura-tabla">
        <table class="tabla">
          <thead>
            <tr><th scope="col">Auto</th><th scope="col">Oferta</th><th scope="col">Del precio</th><th scope="col">Estado</th><th scope="col">Enviada</th></tr>
          </thead>
          <tbody>
<% ofertas.forEach((o) => { %>
            <tr>
              <td><a class="enlace" href="/autos/<%= o.auto_id %>"><%= o.marca %> <%= o.modelo %> <%= o.anio %></a></td>
              <td class="sin-corte"><%= formatearPrecio(o.monto_centavos) %></td>
              <td class="sin-corte"><%= formatearPorcentaje((o.monto_centavos * 100) / o.precio_centavos) %></td>
              <td><%= ETIQUETAS.oferta[o.estado] %></td>
              <td><%= formatearFecha(o.creado_en) %></td>
            </tr>
<% }) %>
          </tbody>
        </table>
      </div>
<% } %>

      <h2>Mis publicaciones</h2>
      <p>Tienes <%= activas %> <%= activas === 1 ? 'publicación activa' : 'publicaciones activas' %> de <%= limite %> permitidas.</p>
<% if (publicaciones.length === 0) { %>
      <p class="vacio">Todavía no has publicado ningún auto.</p>
<% } else { %>
      <div class="envoltura-tabla">
        <table class="tabla">
          <thead>
            <tr><th scope="col">Código</th><th scope="col">Auto</th><th scope="col">Precio</th><th scope="col">Estado</th><th scope="col">Enviada</th></tr>
          </thead>
          <tbody>
<% publicaciones.forEach((p) => { %>
            <tr>
              <td><%= p.codigo %></td>
              <td><%= p.marca %> <%= p.modelo %> <%= p.anio %></td>
              <td><%= formatearPrecio(p.precio_centavos) %></td>
              <td>
                <%= ETIQUETAS.estado[p.estado] %>
<% if (p.estado === 'rechazada') { %>
                <br>Motivo: <%= p.motivo_rechazo %>
<% } %>
              </td>
              <td><%= formatearFecha(p.creado_en) %></td>
            </tr>
<% }) %>
          </tbody>
        </table>
      </div>

      <h3>Ofertas recibidas</h3>
<% if (recibidas.length === 0) { %>
      <p class="vacio">Tus publicaciones todavía no tienen ofertas.</p>
<% } else { %>
      <p>Para responder una oferta, acércate a nuestro local: un asesor de Autobahn coordina la reunión con el comprador.</p>
      <div class="envoltura-tabla">
        <table class="tabla">
          <thead>
            <tr><th scope="col">Código</th><th scope="col">Auto</th><th scope="col">Cliente</th><th scope="col">Oferta</th><th scope="col">Del precio</th><th scope="col">Mensaje</th><th scope="col">Recibida</th></tr>
          </thead>
          <tbody>
<% recibidas.forEach((o) => { %>
            <tr>
              <td class="sin-corte"><%= o.codigo %></td>
              <td><%= o.marca %> <%= o.modelo %></td>
              <td><%= o.nombre %> <%= o.inicial %>.</td>
              <td class="sin-corte"><%= formatearPrecio(o.monto_centavos) %></td>
              <td class="sin-corte"><%= formatearPorcentaje((o.monto_centavos * 100) / o.precio_centavos) %></td>
              <td><%= o.mensaje || 'Sin mensaje' %></td>
              <td><%= formatearFecha(o.creado_en) %></td>
            </tr>
<% }) %>
          </tbody>
        </table>
      </div>
<% } %>
<% } %>
    </section>
<%- include('parciales/pie') %>
