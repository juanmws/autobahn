<%- include('parciales/cabecera') %>
    <section class="contenedor seccion">
      <p class="migas"><a class="enlace" href="/autos/<%= auto.id %>">Volver a la ficha del <%= auto.marca %> <%= auto.modelo %></a></p>
      <h1>Calcular el financiamiento</h1>

      <div class="calculadora">
        <div class="calculadora-auto">
<% if (auto.foto_ruta) { %>
          <img src="<%= auto.foto_ruta %>" alt="Foto de referencia de un <%= auto.marca %> <%= auto.modelo %>" width="800" height="533">
<% } %>
          <p class="calculadora-titulo"><%= auto.marca %> <%= auto.modelo %> <%= auto.anio %></p>
          <p class="precio"><%= formatearPrecio(auto.precio_centavos) %></p>
          <ul class="parametros">
            <li>Tasa de interés anual: <%= formatearPorcentaje(parametros.tasaAnualPorcentaje) %></li>
            <li>Abono mínimo: <%= formatearPrecio(minimo) %> (<%= formatearPorcentaje(parametros.abonoMinimoPorcentaje) %> del precio)</li>
            <li>Plazos: de <%= parametros.plazos[0] %> a <%= parametros.plazos[parametros.plazos.length - 1] %> meses</li>
          </ul>
        </div>

        <form class="formulario" method="get" action="/autos/<%= auto.id %>/financiamiento" data-precio-centavos="<%= auto.precio_centavos %>" novalidate>
          <div class="campo">
            <label for="abono">Abono (B/.)</label>
            <input id="abono" name="abono" inputmode="decimal" autocomplete="off" required value="<%= abonoTexto %>"<%- errores.abono ? ' aria-invalid="true" aria-describedby="error-abono"' : ' aria-describedby="porcentaje-abono"' %>>
            <p class="campo-ayuda" id="porcentaje-abono" aria-live="polite"><%= porcentajeAbono === null ? '' : `${formatearPorcentaje(porcentajeAbono)} del precio` %></p>
<% if (errores.abono) { %>
            <p class="campo-error" id="error-abono"><%= errores.abono %></p>
<% } %>
          </div>
          <div class="campo">
            <label for="plazo">Plazo</label>
            <select id="plazo" name="plazo"<%- errores.plazo ? ' aria-invalid="true" aria-describedby="error-plazo"' : '' %>>
<% parametros.plazos.forEach((meses) => { %>
              <option value="<%= meses %>"<%- String(meses) === plazoTexto ? ' selected' : '' %>><%= meses %> meses</option>
<% }) %>
            </select>
<% if (errores.plazo) { %>
            <p class="campo-error" id="error-plazo"><%= errores.plazo %></p>
<% } %>
          </div>
          <div><button class="boton" type="submit">Calcular</button></div>
        </form>
      </div>

<% if (resultado) { %>
      <section class="resultado" aria-labelledby="titulo-resultado">
        <h2 id="titulo-resultado">Resultado a <%= resultado.plazo %> meses</h2>
        <dl class="especificaciones">
          <div><dt>Cuota mensual</dt><dd class="precio precio-grande"><%= formatearPrecio(resultado.cuotaCentavos) %></dd></div>
          <div><dt>Monto a financiar</dt><dd><%= formatearPrecio(resultado.montoCentavos) %></dd></div>
          <div><dt>Total de intereses</dt><dd><%= formatearPrecio(resultado.interesesCentavos) %></dd></div>
          <div><dt>Total a pagar (abono más cuotas)</dt><dd><%= formatearPrecio(resultado.totalCentavos) %></dd></div>
        </dl>
        <p class="ficha-nota">Cálculo referencial; no constituye una aprobación de crédito. Tasa de <%= formatearPorcentaje(resultado.tasaAnualPorcentaje) %> anual, sistema francés.</p>
      </section>
<% } %>
    </section>
    <script src="/js/financiamiento.js" defer></script>
<%- include('parciales/pie') %>
