<article class="tarjeta-auto" data-auto="<%= auto.id %>">
<% if (auto.foto_ruta) { %>
  <div class="tarjeta-imagen"><img src="<%= auto.foto_ruta %>" alt="Foto de referencia de un <%= auto.marca %> <%= auto.modelo %>" width="800" height="533" loading="lazy"></div>
<% } else { %>
  <div class="tarjeta-imagen tarjeta-imagen-silueta"><img src="/img/silueta-auto.svg" alt="" width="320" height="120"></div>
<% } %>
  <div class="tarjeta-cuerpo">
    <p class="condicion condicion-<%= auto.condicion %>"><%= ETIQUETAS.condicion[auto.condicion] %></p>
    <h3 class="tarjeta-titulo"><span class="tarjeta-marca"><%= auto.marca %></span> <%= auto.modelo %></h3>
    <p class="tarjeta-datos"><%= auto.anio %>, <%= formatearKm(auto.kilometraje) %></p>
    <p class="precio"><%= formatearPrecio(auto.precio_centavos) %></p>
    <a class="boton" href="/autos/<%= auto.id %>">Ver detalle<span class="solo-lectores"> del <%= auto.marca %> <%= auto.modelo %></span></a>
  </div>
</article>
