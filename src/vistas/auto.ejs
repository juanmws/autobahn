<%- include('parciales/cabecera') %>
    <article class="contenedor seccion">
      <p class="migas"><a class="enlace" href="/catalogo">Volver al catálogo</a></p>
      <div class="ficha">
<% if (auto.foto_ruta) { %>
        <figure class="ficha-imagen">
          <img src="<%= auto.foto_ruta %>" alt="Foto de referencia de un <%= auto.marca %> <%= auto.modelo %>" width="800" height="533">
          <figcaption>Foto de referencia del modelo, no del auto en venta: <a href="<%= auto.foto_fuente %>"><%= auto.foto_autor %></a>, <%= auto.foto_licencia %>, recortada.</figcaption>
        </figure>
<% } else { %>
        <figure class="ficha-imagen ficha-imagen-silueta"><img src="/img/silueta-auto.svg" alt="" width="640" height="240"></figure>
<% } %>
        <div class="ficha-datos">
          <p class="condicion condicion-<%= auto.condicion %>"><%= ETIQUETAS.condicion[auto.condicion] %></p>
          <h1 class="ficha-titulo"><%= auto.marca %> <%= auto.modelo %></h1>
          <p class="ficha-anio"><%= auto.anio %></p>
          <p class="precio precio-grande"><%= formatearPrecio(auto.precio_centavos) %></p>
<% const esCompradorPosible = !usuario || (usuario.rol === 'cliente' && usuario.id !== auto.vendedor_id); %>
          <p class="ficha-acciones">
            <a class="boton" href="/autos/<%= auto.id %>/financiamiento">Calcular financiamiento</a>
<% if (esCompradorPosible) { %>
            <a class="boton boton-secundario" href="/autos/<%= auto.id %>/prueba-de-manejo">Agendar prueba de manejo</a>
<% } %>
<% if (esCompradorPosible && auto.condicion === 'usado') { %>
            <a class="boton boton-secundario" href="/autos/<%= auto.id %>/oferta">Hacer oferta</a>
<% } %>
          </p>
          <dl class="especificaciones">
            <div><dt>Kilometraje</dt><dd><%= formatearKm(auto.kilometraje) %></dd></div>
            <div><dt>Transmisión</dt><dd><%= ETIQUETAS.transmision[auto.transmision] %></dd></div>
            <div><dt>Combustible</dt><dd><%= ETIQUETAS.combustible[auto.combustible] %></dd></div>
            <div><dt>Motor</dt><dd><%= auto.motor %></dd></div>
            <div><dt>Color</dt><dd><%= auto.color %></dd></div>
            <div><dt>Código</dt><dd><%= auto.codigo %></dd></div>
          </dl>
          <p class="ficha-descripcion"><%= auto.descripcion %></p>
          <p class="ficha-nota">
<% if (auto.condicion === 'nuevo') { %>
            Auto del inventario de Autobahn.
<% } else { %>
            Publicado por un cliente y revisado en nuestro local.
<% } %>
            Puedes verlo en la Vía Ricardo J. Alfaro, de lunes a sábado, de 9:00 a 17:00.
          </p>
        </div>
      </div>
    </article>
<%- include('parciales/pie') %>
